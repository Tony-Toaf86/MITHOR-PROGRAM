<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Backends de Windows (DDC/CI, WMI, gamma, superposición).
    Base para la etapa .NET 8; la compilación actual usa build.ps1.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Mithor.Platform.Windows</AssemblyName>
    <RootNamespace>Mithor.Platform.Windows</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mithor.Core\Mithor.Core.csproj" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
</Project>
